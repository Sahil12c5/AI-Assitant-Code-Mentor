# ============================================================
# .gitignore for Adaptive AI Coding Mentor
# ============================================================

# Compiled Java class files
*.class

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Embedded Tomcat & Server runtimes
tomcat.*/
tomcat.8080/
work/
temp/

# Node.js & Frontend dependencies
node_modules/
frontend/node_modules/
frontend/dist/
dist/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE & Editor files
.idea/
*.iml
*.iws
*.ipr
.vscode/
.settings/
.project
.classpath
.metadata/
bin/
*.sublime-project
*.sublime-workspace

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.AppleDouble
.LSOverride

# Logs & temporary files
*.log
logs/
*.tmp
*.bak
*.swp

# Environment & Secrets
.env
.env.local
.env.*.local
